# ── Production env for the ADMIN PANEL (@kr/admin) ───────────────────────────
# Copy to apps/admin/.env.local ON THE SERVER before running the first build.

# Keep relative so browser calls stay same-origin and the session cookie attaches.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Absolute backend base (server-side only) — points at the api subdomain.
BACKEND_API_BASE_URL=https://api.krfuels.com/api/v1
USER_ORIGIN=https://krfuels.com

# Session cookie shared across all *.krfuels.com subdomains.
COOKIE_DOMAIN=.krfuels.com

# Keep false for a public staff admin. Flip to true only long enough to create
# the first admin account, then revert and rebuild.
NEXT_PUBLIC_ALLOW_REGISTRATION=false

# Firebase web (browser) config — PUBLIC by design (ships to every browser).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBB4h6N8aU78Q0aLaxUYeqZR6kkZToa3OI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=krfuelsgfivibuh.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=krfuelsgfivibuh
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=krfuelsgfivibuh.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=372539814104
NEXT_PUBLIC_FIREBASE_APP_ID=1:372539814104:web:0a721e217c5a01f0aa27ad
NEXT_PUBLIC_FIREBASE_DB=kr-fuels

# SECRET — must match the public site's REVALIDATE_SECRET.
# Copy the real value from your existing apps/admin/.env.local.
REVALIDATE_SECRET=__COPY_FROM_EXISTING_ENV_LOCAL__
