# ── Production env for the BACKEND API (@kr/backend) ─────────────────────────
# Copy to apps/backend/.env.local ON THE SERVER. Server-side only — never
# shipped to the browser, but still keep this file off git (it is gitignored).

# Firestore / Firebase Admin
FIREBASE_ADMIN_PROJECT_ID=krfuelsgfivibuh
FIREBASE_STORAGE_BUCKET=krfuelsgfivibuh.appspot.com
FIREBASE_DB=kr-fuels

# SECRETS — copy the real values from your existing apps/backend/.env.local.
# The private key must be in quotes with literal \n for newlines.
FIREBASE_ADMIN_CLIENT_EMAIL=__COPY_FROM_EXISTING_ENV_LOCAL__
FIREBASE_ADMIN_PRIVATE_KEY="__COPY_FROM_EXISTING_ENV_LOCAL__"

# CORS / cross-origin credentialed auth.
# USER_ORIGIN is a comma-separated list: the public site answers on BOTH the apex
# and the www host, and the browser sends whichever the visitor actually used.
# Omitting www makes the contact/feedback forms fail with "Failed to fetch".
ADMIN_ORIGIN=https://admin.krfuels.com
USER_ORIGIN=https://krfuels.com,https://www.krfuels.com
COOKIE_DOMAIN=.krfuels.com
