# ── Production env for the PUBLIC WEBSITE (@kr/user) ─────────────────────────
# Copy to apps/user/.env.local ON THE SERVER before running the first build.
# NEXT_PUBLIC_* values are baked in at build time.

NEXT_PUBLIC_API_BASE_URL=https://api.krfuels.com/api/v1
NEXT_PUBLIC_SITE_URL=https://krfuels.com
NEXT_PUBLIC_ADMIN_URL=https://admin.krfuels.com

# SECRET — must be identical to the admin app's REVALIDATE_SECRET.
# Copy the real value from your existing apps/user/.env.local.
REVALIDATE_SECRET=__COPY_FROM_EXISTING_ENV_LOCAL__
